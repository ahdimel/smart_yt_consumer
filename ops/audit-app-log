#!/usr/bin/env python3
"""Audit the server's own log (M5): every line must be one the app or uvicorn is known to write.

Reads `railway logs --service server` (plain or --json) on stdin. Counts each known kind of line
and flags anything else. A flagged line is printed as its line number in the input, its length
and a few yes/no checks, never its text, so the audit can't echo content it found. To read one,
look at that line of your own `railway logs` output. The known lines carry job IDs, user IDs,
codes and counts only (server/app.py, mail.py, retention.py; HANDOFF "M5 brief").

    railway logs --service server --json -n 1000 | ops/audit-app-log
"""
import json
import re
import sys

N = r'\d+'
W = r'[\w-]+'
PROVENANCE = rf'site={W} origin=(absent|null|self|other) cookie=(yes|no)'
KNOWN = {
    'started': rf'started mailer=(resend|none)',
    'submit': rf'submit job={N} user={N} status=(queued|running|done|failed)',
    'claim': rf'claim job={N} attempt={N}',
    'report': rf'(complete|fail) job={N}( rejected={W})?',
    'mail': rf'mail job={N} attempt={N} outcome=(sent|retry|failed|expired)( http=({N}|None))?',
    'mail error': rf'mail job={N} error=\w+',
    'mail loop error': r'mail loop error=\w+',
    'purge': rf'purge summaries={N} jobs={N}',
    'purge error': r'purge error=\w+',
    'admin': rf'(invite|revoke|reissue) user={N}',
    'pause': r'paused|resumed',
    'share': rf'share {PROVENANCE}',
    'refused': rf'refused cross_origin {PROVENANCE}',
    # uvicorn's own lifecycle lines; access lines are off (--no-access-log)
    'uvicorn': (r'(Started|Finished) server process \[\d+\]|Waiting for application '
                r'(startup|shutdown)\.|Application (startup|shutdown) complete\.|Uvicorn running '
                r'on http://[\d.:\[\]]+ \(Press CTRL\+C to quit\)|Shutting down'),
    # Railway's own container lines
    'railway': r'(Starting|Stopping) Container|Mounting volume on: \S+',
}
PATTERNS = {k: re.compile(v) for k, v in KNOWN.items()}
PREFIX = re.compile(r'^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d,\d{3} (INFO|WARNING|ERROR) |'
                    r'(INFO|WARNING|ERROR):\s+)')

counts = {k: 0 for k in KNOWN}
flags = 0
for lineno, raw in enumerate(sys.stdin, 1):
    line = raw.rstrip('\n')
    try:
        d = json.loads(line)
        line = d.get('message', '') if isinstance(d, dict) else line
    except ValueError:
        pass
    msg = PREFIX.sub('', line.strip(), count=1)
    if not msg:
        continue
    kind = next((k for k, p in PATTERNS.items() if p.fullmatch(msg)), None)
    if kind:
        counts[kind] += 1
        continue
    flags += 1
    checks = {'youtube': bool(re.search('youtu', msg, re.I)), 'url': 'http' in msg,
              'traceback': bool(re.match(r'Traceback|File "|\w+(Error|Exception)\b', msg))}
    print(f'FLAG  input line {lineno}: {len(msg)} chars, '
          + ', '.join(f'{k}={"yes" if v else "no"}' for k, v in checks.items()))

for k, n in counts.items():
    if n:
        print(f'{n:6}  {k}')
print(f'unknown lines: {flags}')
