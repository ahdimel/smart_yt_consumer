#!/usr/bin/env bash
# vsum <youtube-url> — fetch a video's transcript + top comments into a model-input bundle.
#   Prints the bundle path. With the `claude` CLI installed, also writes the summary.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
URL="${1:?usage: vsum <youtube-url>}"
CACHE="${VSUM_CACHE:-$ROOT/.cache}"
OUT="${VSUM_OUT:-$ROOT/out}"
mkdir -p "$CACHE" "$OUT"

ID="$(yt-dlp --skip-download --print '%(id)s' --no-warnings "$URL" | tail -1)"
STEM="$CACHE/$ID"

if [[ ! -f "$STEM.info.json" ]]; then
  echo "fetching $ID ..." >&2
  # "en.*" also matches auto-TRANSLATED tracks (en-zh, en-es, ...). Each is a
  # separate request, and enough of them in a batch trips YouTube's rate limiter.
  # Ask only for the tracks the flattener actually reads.
  # --ignore-errors matters too: without it one failed subtitle track aborts the
  # whole fetch and discards the info.json and comments already downloaded.
  yt-dlp --skip-download --no-warnings --ignore-errors \
    --sleep-requests 0.7 --retries 5 --retry-sleep 3 \
    --write-auto-subs --write-subs --sub-langs "en,en-US,en-GB,en-orig" --sub-format vtt \
    --write-info-json --write-comments \
    --extractor-args "youtube:comment_sort=top;max_comments=120,100,20,1" \
    -o "$CACHE/%(id)s" "$URL" >&2

  # --ignore-errors can still leave a fetch without the metadata we need
  [[ -f "$STEM.info.json" ]] || { echo "no info.json for $ID" >&2; exit 1; }
else
  echo "cached $ID" >&2
fi

BUNDLE="$CACHE/$ID.bundle.txt"
python3 "$ROOT/lib/bundle.py" "$STEM" > "$BUNDLE"
echo "bundle: $BUNDLE ($(wc -w < "$BUNDLE" | tr -d ' ') words)" >&2

# drain does its own summarize (with tools disabled) and needs the BUNDLE path
# back, not a summary path. Without this guard the two collide silently.
if [[ -z "${VSUM_FETCH_ONLY:-}" ]] && command -v claude >/dev/null 2>&1; then
  SLUG="$(date +%Y-%m-%d)-$ID"
  claude -p "$(cat "$ROOT/prompts/summarize.md")" < "$BUNDLE" > "$OUT/$SLUG.md"
  echo "$OUT/$SLUG.md"
else
  echo "$BUNDLE"
fi
