#!/usr/bin/env bash
# drain — process every queued URL, rebuild this week's page, publish the artifact.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.nvm/versions/node/v24.15.0/bin:$PATH"

log(){ printf '%s  %s\n' "$(date +%H:%M:%S)" "$*" >&2; }

command -v yt-dlp >/dev/null || { log "FATAL: yt-dlp not on PATH"; exit 1; }
command -v claude >/dev/null || { log "FATAL: claude CLI not on PATH"; exit 1; }

git pull --rebase --autostash --quiet 2>/dev/null || log "warn: git pull failed, continuing with local queue"

# Claude Code on the web pushes to its own branch rather than to main. Adopt any
# such branch whose diff touches ONLY queue/ -- that is a queued URL, not a code
# change. Anything broader is a real change and is left alone for review.
adopt_queue_branches(){
  git fetch origin --prune --quiet 2>/dev/null || return 0
  local ref br base changed
  while read -r ref; do
    [[ -z "$ref" ]] && continue
    br="${ref#origin/}"
    # compare against the merge base, so this sees only what the branch ADDED --
    # not commits main has moved on by since the branch was cut
    base="$(git merge-base main "$ref" 2>/dev/null)" || continue
    changed="$(git diff --name-only "$base".."$ref" 2>/dev/null)"
    [[ -z "$changed" ]] && continue
    if grep -qv '^queue/' <<<"$changed"; then
      log "branch $br touches more than queue/ -- leaving for review"
      continue
    fi
    if git merge --no-edit -q "$ref" 2>/dev/null; then
      log "adopted queued URL(s) from $br"
      git push -q origin --delete "$br" 2>/dev/null && log "  deleted remote $br"
    else
      git merge --abort 2>/dev/null
      log "warn: could not merge $br"
    fi
  done < <(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/claude/*')
}
adopt_queue_branches

shopt -s nullglob
FILES=(queue/*.txt)
[[ ${#FILES[@]} -eq 0 ]] && { log "queue empty"; exit 0; }

WEEK="$(python3 -c 'import sys;sys.path.insert(0,"lib");import week;print(week.iso_week())')"
mkdir -p "out/$WEEK"
ADDED=0

for f in "${FILES[@]}"; do
  URL="$(tr -d '[:space:]' < "$f")"
  [[ -z "$URL" ]] && { rm -f "$f"; continue; }
  log "processing $URL"

  ID="$(yt-dlp --skip-download --print '%(id)s' --no-warnings "$URL" 2>/dev/null | tail -1)"
  if [[ -z "$ID" ]]; then log "  could not resolve id, leaving queued"; continue; fi

  if [[ -f "out/$WEEK/$ID.md" ]]; then
    log "  already summarized this week, dropping from queue"; rm -f "$f"; continue
  fi

  BUNDLE="$(VSUM_FETCH_ONLY=1 ./vsum "$URL" 2>/dev/null | tail -1)"
  if [[ ! -s "$BUNDLE" ]] || [[ "$BUNDLE" != *.bundle.txt ]]; then
    log "  fetch failed, leaving queued"; continue
  fi

  # Tools are disallowed so this is a pure text transform. With them enabled the
  # agent reads CLAUDE.md, writes the files itself and prints nothing to stdout --
  # the work lands, but the redirect below captures an empty file and reports failure.
  # The prompt MUST come before --disallowed-tools: the flag is variadic and will
  # otherwise swallow the prompt, turning every word of it into a bogus deny rule.
  if claude -p "$(cat prompts/summarize.md)" \
       --disallowed-tools "Bash,Edit,Write,Read,Glob,Grep,NotebookEdit,Task,Artifact,WebFetch,WebSearch" \
       < "$BUNDLE" > "out/$WEEK/$ID.md.raw" 2>/dev/null && [[ -s "out/$WEEK/$ID.md.raw" ]] \
     && python3 lib/clean.py "out/$WEEK/$ID.md.raw" "out/$WEEK/$ID.md.tmp"; then
    # stamp the real ingest time; the model copies the example value otherwise
    python3 - "out/$WEEK/$ID.md.tmp" "out/$WEEK/$ID.md" <<'PY'
import re, sys, datetime
src, dst = sys.argv[1], sys.argv[2]
t = datetime.datetime.now().strftime('%Y-%m-%dT%H:%M:%S')
s = open(src, encoding='utf-8').read()
s = re.sub(r'^added:.*$', 'added: ' + t, s, count=1, flags=re.M)
open(dst, 'w', encoding='utf-8').write(s)
PY
    rm -f "out/$WEEK/$ID.md.tmp" "out/$WEEK/$ID.md.raw" "$f"
    ADDED=$((ADDED+1)); log "  summarized -> out/$WEEK/$ID.md"
  else
    rm -f "out/$WEEK/$ID.md.tmp" "out/$WEEK/$ID.md.raw"
    log "  summarize failed, leaving queued"
  fi
done

[[ $ADDED -eq 0 ]] && { log "nothing new"; exit 0; }

python3 lib/week.py "$WEEK" >/dev/null && log "rebuilt out/$WEEK/index.html"

git add -A out queue && git commit -q -m "digest: $ADDED video(s) for $WEEK" && git push -q \
  && log "pushed" || log "warn: git push failed"

# Republish the week's artifact. A stored URL means update-in-place; no meta.json
# means it is a new week, so publish fresh and record the URL that comes back.
claude -p "Publish out/$WEEK/index.html as this week's artifact, following the publishing
rule in CLAUDE.md. Read out/$WEEK/meta.json first: if it has artifact_url, pass that as the
url parameter to update in place. If there is no meta.json, publish fresh and then write
{\"week\":\"$WEEK\",\"artifact_url\":\"<returned url>\",\"published\":\"$(date +%F)\"} to
out/$WEEK/meta.json and commit it. Report only the final URL." >/dev/null 2>&1 \
  && log "artifact published" || log "warn: artifact publish failed — run ./drain-publish by hand"
