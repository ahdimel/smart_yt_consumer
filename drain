#!/usr/bin/env bash
# drain — process every queued URL, rebuild this week's page, publish the artifact.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.nvm/versions/node/v24.15.0/bin:$PATH"

log(){ printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }

# macOS ships no coreutils timeout; perl's alarm is always present.
run_capped(){ local secs=$1; shift; perl -e 'alarm shift; exec @ARGV' "$secs" "$@"; }

command -v yt-dlp >/dev/null || { log "FATAL: yt-dlp not on PATH"; exit 1; }
command -v claude >/dev/null || { log "FATAL: claude CLI not on PATH"; exit 1; }

git pull --rebase --autostash --quiet 2>/dev/null || log "warn: git pull failed, continuing with local queue"

# Claude Code on the web pushes to its own branch rather than to main. Adopt any
# such branch whose diff touches ONLY queue/ -- that is a queued URL, not a code
# change. Anything broader is a real change and is left alone for review.
adopt_queue_branches(){
  git fetch origin --prune --quiet 2>/dev/null || return 0
  local ref br base changed
  while read -r ref; do
    [[ -z "$ref" ]] && continue
    br="${ref#origin/}"
    # compare against the merge base, so this sees only what the branch ADDED --
    # not commits main has moved on by since the branch was cut
    base="$(git merge-base main "$ref" 2>/dev/null)" || continue
    changed="$(git diff --name-only "$base".."$ref" 2>/dev/null)"
    [[ -z "$changed" ]] && continue
    if grep -qv '^queue/' <<<"$changed"; then
      log "branch $br touches more than queue/ -- leaving for review"
      continue
    fi
    if git merge --no-edit -q "$ref" 2>/dev/null; then
      log "adopted queued URL(s) from $br"
      git push -q origin --delete "$br" 2>/dev/null && log "  deleted remote $br"
    else
      git merge --abort 2>/dev/null
      log "warn: could not merge $br"
    fi
  done < <(git for-each-ref --format='%(refname:short)' 'refs/remotes/origin/claude/*')
}
adopt_queue_branches

shopt -s nullglob
FILES=(queue/*.txt)
[[ ${#FILES[@]} -eq 0 ]] && { log "queue empty"; exit 0; }

WEEK="$(python3 -c 'import sys;sys.path.insert(0,"lib");import week;print(week.iso_week())')"
mkdir -p "out/$WEEK"
ADDED=0

for f in "${FILES[@]}"; do
  URL="$(tr -d '[:space:]' < "$f")"
  [[ -z "$URL" ]] && { rm -f "$f"; continue; }
  log "processing $URL"

  ID="$(yt-dlp --skip-download --print '%(id)s' --no-warnings "$URL" 2>/dev/null | tail -1)"
  if [[ -z "$ID" ]]; then log "  could not resolve id, leaving queued"; continue; fi

  if [[ -f "out/$WEEK/$ID.md" ]]; then
    log "  already summarized this week, dropping from queue"; rm -f "$f"; continue
  fi

  BUNDLE="$(VSUM_FETCH_ONLY=1 ./vsum "$URL" 2>/dev/null | tail -1)"
  if [[ ! -s "$BUNDLE" ]] || [[ "$BUNDLE" != *.bundle.txt ]]; then
    log "  fetch failed, leaving queued"; continue
  fi

  # Tools are disallowed so this is a pure text transform. With them enabled the
  # agent reads CLAUDE.md, writes the files itself and prints nothing to stdout --
  # the work lands, but the redirect below captures an empty file and reports failure.
  # The prompt MUST come before --disallowed-tools: the flag is variadic and will
  # otherwise swallow the prompt, turning every word of it into a bogus deny rule.
  log "  summarizing (cap ${SUMMARIZE_CAP:-600}s)"
  if run_capped "${SUMMARIZE_CAP:-600}" claude -p "$(cat prompts/summarize.md)" \
       --disallowed-tools "Bash,Edit,Write,Read,Glob,Grep,NotebookEdit,Task,Artifact,WebFetch,WebSearch" \
       < "$BUNDLE" > "out/$WEEK/$ID.md.raw" 2>/dev/null && [[ -s "out/$WEEK/$ID.md.raw" ]] \
     && python3 lib/clean.py "out/$WEEK/$ID.md.raw" "out/$WEEK/$ID.md.tmp"; then
    # stamp the real ingest time; the model copies the example value otherwise
    python3 - "out/$WEEK/$ID.md.tmp" "out/$WEEK/$ID.md" <<'PY'
import re, sys, datetime
src, dst = sys.argv[1], sys.argv[2]
t = datetime.datetime.now().strftime('%Y-%m-%dT%H:%M:%S')
s = open(src, encoding='utf-8').read()
s = re.sub(r'^added:.*$', 'added: ' + t, s, count=1, flags=re.M)
open(dst, 'w', encoding='utf-8').write(s)
PY
    rm -f "out/$WEEK/$ID.md.tmp" "out/$WEEK/$ID.md.raw" "$f"
    ADDED=$((ADDED+1)); log "  summarized -> out/$WEEK/$ID.md"
  else
    rm -f "out/$WEEK/$ID.md.tmp" "out/$WEEK/$ID.md.raw"
    log "  summarize failed, leaving queued"
  fi
done

[[ $ADDED -eq 0 ]] && { log "nothing new"; exit 0; }

python3 lib/week.py "$WEEK" >/dev/null && log "rebuilt out/$WEEK/index.html"

git add -A out queue && git commit -q -m "digest: $ADDED video(s) for $WEEK" && git push -q \
  && log "pushed" || log "warn: git push failed"

# Republish the week's artifact.
#
# The new-week and update cases are separate prompts: a single conditional prompt
# left the model to choose, and on the W39 rollover it chose not to publish at all.
# drain also writes meta.json itself rather than asking the model to.
PUBLOG="out/$WEEK/.publish.log"
META="out/$WEEK/meta.json"
URL=""
[[ -f "$META" ]] && URL="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('artifact_url',''))" "$META" 2>/dev/null)"

if [[ -n "$URL" ]]; then
  log "updating artifact in place: $URL"
  run_capped 900 claude -p "Use the Artifact tool. Read the artifact at $URL, then republish the
local file out/$WEEK/index.html to that SAME url by passing url=$URL. The local file is
regenerated from this week's summaries and is authoritative. Do not create a new artifact.
Report only the final URL." > "$PUBLOG" 2>&1
else
  log "new week — publishing a fresh artifact for $WEEK"
  run_capped 900 claude -p "Use the Artifact tool to publish the local file
out/$WEEK/index.html as a NEW artifact. There is no existing artifact for this week, so do NOT
pass a url parameter — a fresh publish is correct and expected here. Use icon 'calendar'.
After publishing, reply with the artifact URL on a line by itself and nothing else." \
    > "$PUBLOG" 2>&1
  # drain records the URL; the model is not asked to write files
  NEWURL="$(grep -oE 'https://claude\.ai/artifact/[A-Za-z0-9]+' "$PUBLOG" | tail -1)"
  if [[ -n "$NEWURL" ]]; then
    python3 - "$WEEK" "$NEWURL" "$META" <<'PY'
import json, sys, datetime
week, url, path = sys.argv[1], sys.argv[2], sys.argv[3]
json.dump({'week': week, 'artifact_url': url,
           'published': datetime.date.today().isoformat()},
          open(path, 'w'), indent=2)
open(path, 'a').write('\n')
PY
    log "  recorded $NEWURL in $META"
  fi
fi

# Verify rather than trust: `claude -p` exits 0 whenever the session ends, whether
# or not anything was published. Only meta.json proves it.
FINAL=""
[[ -f "$META" ]] && FINAL="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('artifact_url',''))" "$META" 2>/dev/null)"
if [[ -n "$FINAL" ]]; then
  log "artifact live: $FINAL"
  git add -A out && git commit -q -m "publish: $WEEK artifact" 2>/dev/null && git push -q 2>/dev/null
else
  log "ARTIFACT PUBLISH FAILED for $WEEK — model output in $PUBLOG"
  log "  last line: $(tail -1 "$PUBLOG" 2>/dev/null | cut -c1-160)"
fi

# Refresh the standing index so there is one stable link that always lists the
# current week. Each week's artifact has its own URL; without this the user has
# no way to find a new week's link.
IDXMETA="out/index.meta.json"
if [[ -f "$IDXMETA" ]]; then
  IDXURL="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('artifact_url',''))" "$IDXMETA" 2>/dev/null)"
  python3 lib/index_page.py >/dev/null 2>&1
  if [[ -n "$IDXURL" ]]; then
    log "refreshing index: $IDXURL"
    run_capped 600 claude -p "Use the Artifact tool. Read the artifact at $IDXURL, then republish
the local file out/index.html to that SAME url by passing url=$IDXURL. Do not create a new
artifact. Reply with the URL only." > out/.index.log 2>&1
    grep -q "$IDXURL" out/.index.log 2>/dev/null && log "  index refreshed" \
      || log "  warn: index refresh may have failed — see out/.index.log"
  fi
  git add -A out && git commit -q -m "index: refresh" 2>/dev/null && git push -q 2>/dev/null
fi
